# Free LLM providers for laboratory/agents.
#
# Copy to .env (git-ignored) and fill in only the providers you signed up for:
#
#     cp .env.example .env
#
# Empty values are ignored, and the keyless providers below work with no key at
# all, so every agent experiment runs before you add anything. Variables that
# are already set in your shell take precedence over this file.
#
# One naming rule for every provider id (the id is what --model accepts):
#     <ID>_API_KEY   the key
#     <ID>_BASE_URL  optional URL override, e.g. ZHIPU_BASE_URL for bigmodel.cn
#
# Which models are free, with limits and tool support: data/free_models.json
# (refresh with `python data/prepare_free_models.py`). Live catalogs:
#     https://freellmapi.co/models
#     https://unorouter.com/en/models?max_price=0
# Check what your keys unlock:
#     python experiments/agents/provider_survey/run.py --tier smoke

# -----------------------------------------------------------------------------
# No key needed: anonymous access works, a key only raises the limits
# -----------------------------------------------------------------------------

# Kilo Gateway — :free routes answer anonymously, 200 requests/hour per IP; free prompts may be logged
# https://app.kilo.ai
KILO_API_KEY=

# OVH AI Endpoints — anonymous tier: 2 requests/min per IP per model
# https://endpoints.ai.cloud.ovh.net
OVH_API_KEY=

# LLM7 — anonymous access works; a free token raises the limits
# https://llm7.io
LLM7_API_KEY=

# AI Horde — volunteer GPUs: slow queue, rotating roster, no tool calling; a key raises queue priority
# https://aihorde.net/register
AIHORDE_API_KEY=

# -----------------------------------------------------------------------------
# First-party labs and clouds
# -----------------------------------------------------------------------------

# Google AI Studio — per-model RPM/RPD caps; hidden thinking tokens count against max_tokens
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Groq — free key, no card; per-model RPM/RPD caps
# https://console.groq.com/keys
GROQ_API_KEY=

# Mistral — free Experiment plan
# https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=

# Cohere — trial key with monthly call caps
# https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# NVIDIA NIM — about 40 RPM per account; evaluation-only terms; one tool call per turn
# https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=

# Cloudflare Workers AI — 10,000 neurons/day; API token with Workers AI permission plus CLOUDFLARE_ACCOUNT_ID
# https://dash.cloudflare.com
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_KEY=

# Zhipu AI (Z.ai) — keys from open.bigmodel.cn need ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# https://z.ai/manage-apikey/apikey-list
ZHIPU_API_KEY=

# ModelScope — the token works only after binding a real-name Alibaba Cloud China account
# https://modelscope.cn/my/myaccesstoken
MODELSCOPE_API_KEY=

# SEA-LION — AI Singapore; 10 RPM
# https://sea-lion.ai
SEALION_API_KEY=

# Agnes AI — promotional $0 pricing on Agnes models
# https://platform.agnes-ai.com
AGNES_API_KEY=

# AMD Radeon Cloud — rotating free roster; one tool call per turn; long reasoning
# https://developer.amd.com.cn/radeon/tokenfactory
RADEON_API_KEY=

# Moondream — vision model; $5/month shared credits; no tools or stop sequences
# https://moondream.ai/c/cloud/api-keys
MOONDREAM_API_KEY=

# -----------------------------------------------------------------------------
# Routers and gateways with free models
# -----------------------------------------------------------------------------

# UnoRouter — :free models: 1 request/min per model; bursts trip an account-wide 429
# https://unorouter.com
UNOROUTER_API_KEY=

# OpenRouter — :free models share 50 requests/day per account (1,000 after a one-time $10 top-up)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# xKiro — 5M free tokens/day; premium models answer 403
# https://xkiro.com
XKIRO_API_KEY=

# ElectronHub — shared weekly free credits
# https://app.electronhub.ai
ELECTRONHUB_API_KEY=

# Requesty — free key, no card
# https://www.requesty.ai
REQUESTY_API_KEY=

# Routeway — :free models, roughly 5-20 RPM
# https://routeway.ai
ROUTEWAY_API_KEY=

# NaraRouter — daily free quota after Telegram verification
# https://router.bynara.id
NARA_API_KEY=

# BazaarLink — only the auto:free route is free
# https://bazaarlink.ai
BAZAARLINK_API_KEY=

# Aion Labs — free key, no card
# https://www.aionlabs.ai
AION_API_KEY=

# Router9 — shared monthly free credits
# https://www.router9.com
ROUTER9_API_KEY=

# Speka — shared $1/month free credits
# https://speka.me/dashboard/keys
SPEKA_API_KEY=

# Septor Labs — shared daily free quota; several aliases substitute another model
# https://septorlabs.com/dashboard
SEPTOR_API_KEY=

# CLōD — shared daily free requests
# https://app.clod.io
CLOD_API_KEY=

# Api.Airforce — 1 request/min per account
# https://api.airforce
AIRFORCE_API_KEY=

# DreamPrompting — 500K tokens and 5,000 requests per rolling 24 h; pooled router
# https://dreamprompting.com
DREAMPROMPTING_API_KEY=

# Waterfall — community free models
# https://getwaterfall.org
WATERFALL_API_KEY=

# Logfare — fair-use free tier that logs all traffic
# https://logfare.ai
LOGFARE_API_KEY=

# LLMTR — daily free-model quotas; automated key probing gets accounts suspended
# https://llmtr.com
LLMTR_API_KEY=

# Gizmo — monthly free requests; text only, no tools
# https://gizmoplatforms.com/developers
GIZMO_API_KEY=

# BlockRun — zero-priced routes
# https://user.blockrun.ai/dashboard/keys
BLOCKRUN_API_KEY=

# ACLIDE — OpenAI Responses API; shared monthly credits; closed to new sign-ups
# https://aclide.com/en/dashboard/api-keys
ACLIDE_API_KEY=

# -----------------------------------------------------------------------------
# Local and self-hosted endpoints (use with --model freellmapi:auto or custom:<model>)
# -----------------------------------------------------------------------------

# FreeLLMAPI router — one unified key in front of every provider above (https://github.com/tashfeenahmed/freellmapi).
# Models: auto, auto:fast, auto:smart, or any id from its dashboard.
FREELLMAPI_BASE_URL=http://localhost:3001/v1
FREELLMAPI_API_KEY=

# Any OpenAI-compatible server: Ollama http://localhost:11434/v1,
# LM Studio http://localhost:1234/v1, vLLM, llama.cpp. The key is optional.
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
